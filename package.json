{
  "name": "dsh-routing-quality",
  "version": "0.2.4",
  "description": "按风险与复杂度节流的 DSH 路由和 API 输出质量插件：零额外模型生成请求、三档契约、模型能力感知的 effort clamp、本地结构检查。",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "routing",
    "api-quality",
    "json-output"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nanshan69/dsh-routing-quality.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
